# =====================================================================================
# Pile de TEST (docker-compose.test.yml) — modele a copier en .env.test SUR LE SERVEUR.
# .env.test n'est jamais versionne : il porte des mots de passe.
#
# Regle de lecture : tout ce qui est ci-dessous doit DIFFERER de .env.prod, sauf ce qui
# est marque « identique a la production ».
# =====================================================================================

# --- Base de TEST (conteneur postgrecontainer-test, volume digi_test_postgres_data) ---
# Le nom de la base reste localdb pour qu'une copie de production se restaure telle quelle.
# C'est l'INSTANCE qui change, pas le nom : aucune confusion possible, les deux conteneurs
# ne partagent ni volume ni reseau.
POSTGRES_USER=user2711
POSTGRES_DB=localdb
POSTGRES_PASSWORD=<mot de passe PROPRE AU TEST, different de la production>
DB_USERNAME=user2711
DB_PASSWORD=<le meme que POSTGRES_PASSWORD>

# --- Adresses publiques, servies par le nginx de production ---
UI_APP_URL=https://test.digi-creditrural-io.com
BACKEND_APP_URL=https://test.digi-creditrural-io.com
OAUTH_ISSUER=https://test.digi-creditrural-io.com/auth

# --- Compte de service Eureka (identique a la production : il vient de la base restauree) ---
# ⚠️ Ce mot de passe expire a 365 jours et coupe toute la pile au redemarrage suivant.
EUREKA_PASSWORD=admin2711

# --- Application mobile ---
# Meme schema qu'en production : c'est la meme application, construite avec EXPO_PUBLIC_ENV=test.
MOBILE_OIDC_REDIRECT_URI=com.digiservices.digicrg://oauth2redirect
# Redirection supplementaire pour le client de developpement Expo. Vide = aucune.
MOBILE_OIDC_EXTRA_REDIRECT_URI=

# --- Cles de signature OIDC, PROPRES AU TEST ---------------------------------------
# A generer une fois : ./generate-key.sh puis deplacer la paire dans ce dossier.
# Ne jamais reutiliser la paire de production : un jeton signe par le test serait
# accepte par les services de production.
TEST_KEYS_DIR=/etc/crg/keys-test

# --- SAF : SAUVEGARDE uniquement (profil saf), jamais la base bancaire vivante ---
SAF_SAUVEGARDE_USERNAME=DIGI_LECTURE
SAF_SAUVEGARDE_PASSWORD=<mot de passe de lecture de la sauvegarde SAF>

# --- Images a tester -----------------------------------------------------------------
# latest = ce qui tourne en production. Mettre un autre marqueur pour essayer une version
# avant de la livrer, par exemple le court du commit.
TEST_IMAGE_TAG=latest

# --- Rien ne sort de cette pile -------------------------------------------------------
# Le courtier Kafka est celui de la pile de test (kafka-test). Ne JAMAIS pointer cette
# variable sur le kafka de production : le notificationservice de production consommerait
# les evenements de test et enverrait de vrais courriels.
TEST_KAFKA=kafka-test:9092
# Les courriels du service de notification de test finissent dans le piege mailpit-test,
# visibles par tunnel SSH (port 18025). Les alertes du portefeuille peuvent donc etre
# activees en test : elles n atteignent personne.
TEST_ALERTES_ACTIVES=false

# --- Application web de test (profil web) -----------------------------------------------
# Image construite par le workflow test-cd avec les adresses de test figees dedans.
# start-test.sh n ajoute le profil que si cette image est presente sur la machine.
TEST_APP_IMAGE_TAG=test

# --- Cles d API PROPRES AU TEST (jamais celles de production) ----------------------------
TEST_AGRIPILOT_PUBLIC_API_KEY=<cle de test>
TEST_EBANKING_AGRI_API_KEY=<cle de test>
TEST_KUMY_AGENTS_API_KEY=<cle de test>
TEST_BCRG_PUBLIC_API_KEY=<cle de test>
TEST_BCRG_INTERNAL_API_KEY=<cle de test>

# Profil Spring : prod, comme en production. Il n'existe pas de profil « test » dans les
# services ; en inventer un ferait retomber les services sur localhost.
SPRING_PROFILES_ACTIVE=prod
